name: CI-2

description: actions

on:
  push:
    branches:
      - main

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - name: Repo auschecke
        uses: actions/checkout@v4

      - name: Linting
        run: echo "Hier kommt das Linting"


      - name: Dependency installieren
        run: npm ci --legacy-peer-deps

      - name: Tests
        run: echo "Hier kommen die Tests"
